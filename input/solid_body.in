# equation of state 
gamma           = 1.4

# simulation 
tmax            = 5.0           # 
stepmax         = -1            # unlimitted
CFL             = 0.5           # CFL number ( CFL < 1 ), dt depends on CFL
integrator      = 2             # 1 : forward euler; 2 : rk2; 3: rk3
RcOrder         = 2             # order of spatial reconstruction

# output
dtoutput        = 0.5          # output every dtoutput
dataType        = 0             # 0: output cons; 1: output prim

# domain size 
xmin            = -5
xmax            =  5
ymin            = -5
ymax            =  5
zmin            = -0.5
zmax            =  0.5

# mesh 
NX              = 1024           # resolution on x   
NY              = 1024           # resolution on y 
NZ              = 1             # resolution on z 

NGhost          = 2             # number of ghost cell ( usually is 1 )

# boundary 
# 0: copy, 1: periodic, 2: reflective, 3 for outflow
xleft           = 3             # 
xright          = 3             # 
yleft           = 3             # 
yright          = 3
zleft           = 1
zright          = 1

# problem setup
r_solid         = 1.0           # 
x0              = -3.0          # 
y0              = 0.0           # 
z0              = 0.0           # 
rho             = 1.0           # 
p               = 1.0           # 
vxIn            = 4.0           #
